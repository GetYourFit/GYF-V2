{
  "name": "@gyf/expo",
  "private": true,
  "version": "0.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "EXPO_NO_TELEMETRY=1 EXPO_NO_DOCTOR=1 expo export --platform web --clear && node scripts/verify-cuelinks-web-export.mjs",
    "doctor": "EXPO_NO_TELEMETRY=1 expo-doctor",
    "check:web-env": "node scripts/check-web-env.mjs",
    "deploy": "npm run doctor && npx eas-cli@21.4.0 env:exec production \"EXPO_NO_TELEMETRY=1 EXPO_NO_DOCTOR=1 expo export --platform web --clear\" && node scripts/verify-cuelinks-web-export.mjs && npm run check:web-env && mkdir -p deploy-records && npx eas-cli@21.4.0 deploy --prod | tee deploy-records/eas-deploy.log && npm run verify:deploy -- --deploy-log deploy-records/eas-deploy.log --evidence-file deploy-records/verification-evidence.json",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "budget:web": "bash scripts/check-bundle-budget.sh web 2700000",
    "budget:android": "bash scripts/check-bundle-budget.sh android 5000000",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "bun test src && bun test scripts"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@gyf/api-client": "workspace:*",
    "@gyf/types": "workspace:*",
    "@supabase/supabase-js": "^2.47.10",
    "expo": "~57.0.9",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.8",
    "expo-file-system": "~57.0.1",
    "expo-font": "^57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-picker": "~57.0.7",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-media-library": "~57.0.3",
    "expo-router": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-server": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-updates": "~57.0.11",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^19.0.0",
    "babel-preset-expo": "~57.0.3",
    "expo-doctor": "1.17.11",
    "typescript": "~6.0.3"
  }
}
