# Copy to .env and fill. Never commit real secrets.

# Web / BFF
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Core API (Settings reads the GYF_ prefix — see services/api/app/config.py)
GYF_ENV=local
# Local/direct fallback target. Production runtime uses the Supabase Supavisor
# transaction-pooler URL (port 6543); retain a direct/session URL (port 5432) in
# GYF_MIGRATION_DATABASE_URL for migrations and use it here only as a fallback.
GYF_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gyf
GYF_DB_POOL_MAX_SIZE=10
GYF_REDIS_URL=redis://localhost:6379/0

# Auth (Supabase JWT). Set GYF_SUPABASE_JWT_SECRET in staging/prod to enforce
# auth on protected routes. Leave empty in local (env=local) for the dev bypass.
GYF_SUPABASE_JWT_SECRET=
# GYF_AUTH_DISABLED=true  # force the dev principal (local only; never in prod)

# Object storage (S3-compatible)
S3_ENDPOINT=
S3_BUCKET=gyf-media
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Auth (OIDC) — fill in P0/P1
AUTH_ISSUER=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=

# Event sink: "local" (JSONL) or "postgres" (interactions table)
GYF_EVENT_SINK=local

# Cuelinks Publisher API (server-side only; never EXPO_PUBLIC_/NEXT_PUBLIC_)
# Used to discover campaigns and convert known product URLs into attributed links.
# Campaigns+convert do not supply product title/image/price/availability rows; keep a
# separate retailer/product feed or product API for real catalogue cards.
GYF_CUELINKS_CID=your-cuelinks-channel-id
GYF_CUELINKS_API_KEY=redacted-cuelinks-publisher-api-token
GYF_CUELINKS_API_BASE_URL=https://developers.cuelinks.com/pub_api/v3
# Optional Cuelinks product ingestion exports when available:
# GYF_CUELINKS_CAMPAIGNS_PATH=./secure/cuelinks-campaigns.csv
# GYF_CUELINKS_PRODUCTS_FEED_PATH=./secure/cuelinks-products.csv

# Local SigLIP2 runtime safety (explicit local_cpu is opt-in; no production cutover here).
# GYF_PERCEPTION_DEVICE=auto        # auto: CUDA/XPU/CPU; MPS is fail-closed
# GYF_PERCEPTION_BATCH_SIZE=16      # validated 1..64
# GYF_PERCEPTION_CPU_THREADS=2      # validated 1..8
# GYF_PERCEPTION_MIN_MEMORY_BYTES=4000000000  # fail closed below detectable limit

# Remote text/image encoder (F2.5). Unset = local CPU SigLIP baseline.
# Point these at the canonical deployed Modal lane (ml/serving/modal_encoder.py) to kill the cold-search path:
#   GYF_ENCODER_REMOTE_KIND=http            # "http" (Modal JSON) or "gradio" (ZeroGPU Space)
#   GYF_ENCODER_REMOTE_URL=https://<your-app>.modal.run   # printed by `modal deploy`
#   GYF_ENCODER_REMOTE_KEY=<gyf-encoder secret value>     # same bearer as the Modal secret

# --- Observability (P0-E). All optional; unset = no-op, no external service needed. ---
# Core API (GYF_ prefix). Metrics are always exposed at /metrics (Prometheus scrape).
# GYF_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318  # enables OTLP tracing
# GYF_SENTRY_DSN=                                          # enables Sentry error reporting
GYF_SERVICE_NAME=gyf-api
GYF_TRACE_SAMPLE_RATE=1.0
# Web (Next.js instrumentation reads standard OTEL_* vars).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=gyf-web
